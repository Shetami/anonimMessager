platform :ios, '17.0'
use_frameworks!

# libsignal and RingRTC (Signal's calling library, on top of WebRTC) ship
# prebuilt binaries for CocoaPods. Each tag and its matching checksum are
# pinned together in .libsignal-version / .ringrtc-version (the same pairs
# Signal-iOS uses; `./bootstrap.sh --update-signal` refreshes them).
def pin(file) = File.readlines(File.join(__dir__, file)).to_h { |l| l.strip.split('=', 2) }
libsignal = pin('.libsignal-version')
ringrtc = pin('.ringrtc-version')
ENV['LIBSIGNAL_FFI_PREBUILD_CHECKSUM'] = libsignal.fetch('LIBSIGNAL_FFI_PREBUILD_CHECKSUM')
ENV['RINGRTC_PREBUILD_CHECKSUM'] = ringrtc.fetch('RINGRTC_PREBUILD_CHECKSUM')

target 'Calculon' do
  pod 'LibSignalClient', git: 'https://github.com/signalapp/libsignal.git', tag: libsignal.fetch('LIBSIGNAL_TAG')
  pod 'SignalRingRTC', git: 'https://github.com/signalapp/ringrtc.git', tag: ringrtc.fetch('RINGRTC_TAG'),
                       inhibit_warnings: true
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # libsignal_ffi.a embeds BoringSSL (C++); with no other C++ pod in the
      # app nothing else pulls in libc++, so link it explicitly.
      if t.name == 'LibSignalClient'
        c.build_settings['OTHER_LDFLAGS'] = '$(inherited) -lc++'
      end
    end
  end
end
